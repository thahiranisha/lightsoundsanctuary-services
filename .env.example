# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and is auto-loaded by docker-compose.
# NEVER commit real secrets.

# Signing key for JWTs. Must be identical for user-service (mints tokens)
# and gateway-service (verifies them). HS256 requires >= 32 bytes.
# Generate one, e.g.:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars

# Shared secret proving a request came through the gateway. The gateway stamps
# it on every forwarded request; downstream services reject requests without it.
# Generate one, e.g.:  openssl rand -base64 48
GATEWAY_INTERNAL_SECRET=change-me-to-a-different-long-random-value

# Google OAuth2 credentials (user-service).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
